{
  "name": "JuraCAD",
  "short_name": "JuraCAD",
  "description": "Free, open-source parametric CAD. Design parts and export STEP, STL or 3MF.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f8",
  "theme_color": "#1f6fd1",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-juracad+json": [".juracad"] } },
    { "action": "./", "accept": { "application/x-partsmith+json": [".partsmith"] } }
  ]
}
